#: src/main.vala:17 src/main.vala:23 src/main.vala:85
msgid "Photo Organizer"
msgstr "Foto-organisator"

#: src/main.vala:31
msgid "About Photo Organizer"
msgstr "Over Foto-organisator"

#: src/main.vala:34
msgid "Main Menu"
msgstr "Hoofdmenu"

#: src/main.vala:39
msgid "Choose Photo Folder…"
msgstr "Fotomap kiezen…"

#: src/main.vala:41
msgid "No folder selected"
msgstr "Geen map geselecteerd"

#: src/main.vala:51
#, c-format
msgid ""
"For exact duplicates, a name without a numbered suffix is preferred; "
"otherwise the earliest-modified copy is moved into %s/YYYY/mm. Additional "
"duplicates are counted and left where they are. When capture-date metadata "
"is missing, the file’s modified date is used."
msgstr ""
"Bij exacte duplicaten heeft een naam zonder nummerachtervoegsel de voorkeur; "
"anders wordt de kopie met de oudste wijzigingsdatum verplaatst naar "
"%s/YYYY/mm. Andere duplicaten worden geteld en blijven op hun plek. Als "
"opnamedatumgegevens ontbreken, wordt de wijzigingsdatum van het bestand gebruikt."

#: src/main.vala:60
msgid "Choose a folder to get started."
msgstr "Kies een map om te beginnen."

#: src/main.vala:61
msgid "Analyze and Organize"
msgstr "Analyseren en organiseren"

#: src/main.vala:87
msgid "Photo Organizer contributors"
msgstr "Bijdragers aan Foto-organisator"

#: src/main.vala:88
msgid "Organize photos by capture date and find exact duplicates."
msgstr "Orden foto's op opnamedatum en vind exacte duplicaten."

#: src/main.vala:93
msgid "Choose Photo Folder"
msgstr "Fotomap kiezen"

#: src/main.vala:104
msgid "Ready to analyze the selected folder."
msgstr "De geselecteerde map is klaar om te analyseren."

#: src/main.vala:107
#, c-format
msgid "Could not choose a folder: %s"
msgstr "Kan geen map kiezen: %s"

#: src/main.vala:121
msgid "Starting…"
msgstr "Starten…"

#: src/main.vala:131
#, c-format
msgid "%.0f%%"
msgstr "%.0f%%"

#: src/main.vala:156
#, c-format
msgid "Moved %u unique photo."
msgid_plural "Moved %u unique photos."
msgstr[0] "%u unieke foto verplaatst."
msgstr[1] "%u unieke foto's verplaatst."

#: src/main.vala:159
#, c-format
msgid "Skipped %u duplicate file, leaving it in place."
msgid_plural "Skipped %u duplicate files, leaving them in place."
msgstr[0] "%u dubbel bestand overgeslagen en op zijn plek gelaten."
msgstr[1] "%u dubbele bestanden overgeslagen en op hun plek gelaten."

#: src/main.vala:164
#, c-format
msgid "Used the file date for %u photo."
msgid_plural "Used the file date for %u photos."
msgstr[0] "De bestandsdatum gebruikt voor %u foto."
msgstr[1] "De bestandsdatum gebruikt voor %u foto's."

#: src/main.vala:175
#, c-format
msgid "%u issue: %s"
msgid_plural "%u issues: %s"
msgstr[0] "%u probleem: %s"
msgstr[1] "%u problemen: %s"

#: src/main.vala:180
#, c-format
msgid ""
"The file system did not allow setting the creation time for %u photo; "
"modification times were set where possible."
msgid_plural ""
"The file system did not allow setting the creation time for %u photos; "
"modification times were set where possible."
msgstr[0] ""
"Het bestandssysteem stond niet toe de aanmaaktijd voor %u foto in te stellen; "
"wijzigingstijden zijn waar mogelijk ingesteld."
msgstr[1] ""
"Het bestandssysteem stond niet toe de aanmaaktijd voor %u foto's in te "
"stellen; wijzigingstijden zijn waar mogelijk ingesteld."

