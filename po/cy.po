#: src/main.vala:51
#, c-format
msgid ""
"For exact duplicates, a name without a numbered suffix is preferred; "
"otherwise the earliest-modified copy is moved into %s/YYYY/mm. Additional "
"duplicates are counted and left where they are. When capture-date metadata "
"is missing, the file’s modified date is used."
msgstr ""
"Ar gyfer copïau dyblyg union, rhoddir blaenoriaeth i enw heb ôl-ddodiad "
"rhif; fel arall, symudir y copi â’r dyddiad addasu cynharaf i %s/YYYY/mm. "
"cyfrifir copïau dyblyg eraill a’u gadael yn eu lle. Os nad oes metadata "
"dyddiad tynnu’r llun, defnyddir dyddiad addasu’r ffeil."

#: src/main.vala:60
msgid "Choose a folder to get started."
msgstr "Dewiswch ffolder i ddechrau."

#: src/main.vala:61
msgid "Analyze and Organize"
msgstr "Dadansoddi a Threfnu"

#: src/main.vala:87
