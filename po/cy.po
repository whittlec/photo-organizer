msgstr "Cyfranwyr Trefnydd Lluniau"

#: src/main.vala:88
msgid "Organize photos by capture date and find exact duplicates."
msgstr "Trefnu lluniau yn ôl dyddiad tynnu a dod o hyd i gopïau dyblyg union."

