#: src/main.vala:17 src/main.vala:23 src/main.vala:85
msgid "Photo Organizer"
msgstr "Organizador de fotos"

#: src/main.vala:31
msgid "About Photo Organizer"
msgstr "Acerca del organizador de fotos"

#: src/main.vala:34
msgid "Main Menu"
msgstr "Menú principal"

#: src/main.vala:39
msgid "Choose Photo Folder…"
msgstr "Elegir carpeta de fotos…"

#: src/main.vala:41
msgid "No folder selected"
msgstr "No hay ninguna carpeta seleccionada"

#: src/main.vala:51
#, c-format
msgid ""
"For exact duplicates, a name without a numbered suffix is preferred; "
"otherwise the earliest-modified copy is moved into %s/YYYY/mm. Additional "
"duplicates are counted and left where they are. When capture-date metadata "
"is missing, the file’s modified date is used."
msgstr ""
"Para los duplicados exactos, se prefiere un nombre sin sufijo numérico; de "
"lo contrario, se mueve a %s/YYYY/mm la copia con la fecha de modificación "
"más antigua. Los demás duplicados se contabilizan y se dejan donde están. "
"Si faltan los metadatos de la fecha de captura, se usa la fecha de "
"modificación del archivo."

#: src/main.vala:60
msgid "Choose a folder to get started."
msgstr "Elige una carpeta para empezar."

#: src/main.vala:61
msgid "Analyze and Organize"
msgstr "Analizar y organizar"

#: src/main.vala:87
msgid "Photo Organizer contributors"
msgstr "Colaboradores del organizador de fotos"

#: src/main.vala:88
msgid "Organize photos by capture date and find exact duplicates."
msgstr "Organiza las fotos por fecha de captura y busca duplicados exactos."

#: src/main.vala:93
msgid "Choose Photo Folder"
msgstr "Elegir carpeta de fotos"

#: src/main.vala:104
msgid "Ready to analyze the selected folder."
msgstr "La carpeta seleccionada está lista para analizarse."

#: src/main.vala:107
#, c-format
msgid "Could not choose a folder: %s"
msgstr "No se pudo elegir una carpeta: %s"

#: src/main.vala:121
msgid "Starting…"
msgstr "Iniciando…"

#: src/main.vala:131
#, c-format
msgid "%.0f%%"
msgstr "%.0f%%"

#: src/main.vala:156
#, c-format
msgid "Moved %u unique photo."
msgid_plural "Moved %u unique photos."
msgstr[0] "Se movió %u foto única."
msgstr[1] "Se movieron %u fotos únicas."

#: src/main.vala:159
#, c-format
msgid "Skipped %u duplicate file, leaving it in place."
msgid_plural "Skipped %u duplicate files, leaving them in place."
msgstr[0] "Se omitió %u archivo duplicado y se dejó en su sitio."
msgstr[1] "Se omitieron %u archivos duplicados y se dejaron en su sitio."

#: src/main.vala:164
#, c-format
msgid "Used the file date for %u photo."
msgid_plural "Used the file date for %u photos."
msgstr[0] "Se usó la fecha del archivo para %u foto."
msgstr[1] "Se usó la fecha del archivo para %u fotos."

#: src/main.vala:175
#, c-format
msgid "%u issue: %s"
msgid_plural "%u issues: %s"
msgstr[0] "%u problema: %s"
msgstr[1] "%u problemas: %s"

#: src/main.vala:180
#, c-format
msgid ""
"The file system did not allow setting the creation time for %u photo; "
"modification times were set where possible."
msgid_plural ""
"The file system did not allow setting the creation time for %u photos; "
"modification times were set where possible."
msgstr[0] ""
"El sistema de archivos no permitió establecer la fecha de creación de %u "
"foto; se establecieron las fechas de modificación cuando fue posible."
msgstr[1] ""
"El sistema de archivos no permitió establecer la fecha de creación de %u "
"fotos; se establecieron las fechas de modificación cuando fue posible."

#: src/main.vala:192
#, c-format
msgid "Could not organize photos: %s"
msgstr "No se pudieron organizar las fotos: %s"

#: src/main.vala:200
