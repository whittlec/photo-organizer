#, c-format
msgid "Moved %u unique photo."
msgid_plural "Moved %u unique photos."
msgstr[0] "%u eindeutiges Foto verschoben."
msgstr[1] "%u eindeutige Fotos verschoben."

#: src/main.vala:159
#, c-format
msgid "Skipped %u duplicate file, leaving it in place."
msgid_plural "Skipped %u duplicate files, leaving them in place."
msgstr[0] "%u Duplikat übersprungen und am ursprünglichen Ort belassen."
msgstr[1] "%u Duplikate übersprungen und am ursprünglichen Ort belassen."

#: src/main.vala:164
#, c-format
msgid "Used the file date for %u photo."
msgid_plural "Used the file date for %u photos."
msgstr[0] "Für %u Foto wurde das Dateidatum verwendet."
msgstr[1] "Für %u Fotos wurde das Dateidatum verwendet."

#: src/main.vala:175
