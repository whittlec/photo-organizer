  <project_license>GPL-3.0-or-later</project_license>
  <name>Photo Organizer</name>
  <summary>Organize photos by capture date and find exact duplicates</summary>
  <icon type="stock">com.github.whittlec.PhotoOrganizer</icon>
  <description>
    <p>
      Photo Organizer sorts photos into year and month folders using the date
      each picture was taken. It can also identify exact duplicate files and
      move the extra copies into a separate folder.
    </p>
    <ul>
      <li>Reads capture dates from EXIF metadata, with a file-date fallback.</li>
      <li>Finds byte-for-byte duplicates and keeps the best-named copy.</li>
      <li>Leaves wallpaper slideshow photos and symbolic links untouched.</li>
      <li>Shows progress while scanning and organizing.</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.github.whittlec.PhotoOrganizer.desktop</launchable>
  <provides>
    <binary>photo-organizer</binary>
  </provides>
  <developer>
    <name>William Whittle</name>
  </developer>
